# Copie este arquivo para .env e ajuste os valores.
# NUNCA faça commit do .env real — ele já está no .gitignore.

# --- Banco de dados ---
# Valor para rodar `npm run dev` no host, com `docker compose up db mailpit`.
# Se rodar o app via `docker compose up` (serviço `app`), o compose já
# sobrescreve isso automaticamente para apontar para o serviço `db`.
# Porta 5433 no PC porque a 5432 costuma estar ocupada por outro PostgreSQL
# (o iniciar-site.bat usa os mesmos valores).
DB_PORT=5433
DATABASE_URL=postgres://lpz:lpz_dev_local@localhost:5433/lpz_training

# --- Modo de teste ---
# =true em desenvolvimento local. Sem MERCADOPAGO_ACCESS_TOKEN, o checkout usa
# a tela de pagamento simulado (/pagamento/simulado), sem nenhuma cobrança.
TEST_MODE=true

# --- Mercado Pago (Checkout Pro) ---
# Preenchido → o site passa a usar o Mercado Pago de verdade.
# Em desenvolvimento use SEMPRE a credencial de TESTE: painel do Mercado Pago
# → Suas integrações → (sua aplicação) → Credenciais de teste → Access Token.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Segredo dos avisos (webhooks): Suas integrações → Webhooks → "Assinatura
# secreta". Só funciona com o site publicado em https (o Mercado Pago não
# alcança o localhost). Sem ele, os avisos são recusados.
MERCADOPAGO_WEBHOOK_SECRET=

# --- URL pública do site (usada em redirects do checkout e e-mails) ---
APP_URL=http://localhost:3005

# --- E-mail transacional (Mailpit em dev, captura tudo localmente) ---
# Produção (Brevo): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_USER = login SMTP do painel Brevo (SMTP e API > SMTP),
# SMTP_PASS = chave SMTP gerada lá. Em dev, deixe SMTP_USER/SMTP_PASS vazios.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=localhost
SMTP_PORT=1026
# Interface do Mailpit no PC (o site mostra em /emails)
MAILPIT_UI_PORT=8026
MAILPIT_URL=http://localhost:8026
EMAIL_FROM=contato@lpztraining.com.br

# --- Login (Better Auth) ---
# Segredo que assina cookies e tokens. Gere um por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# --- Upload de fotos (LocalDiskStorage) ---
UPLOADS_DIR=./uploads

# --- Login com Google (opcional) ---
# Sem estas duas variáveis o botão "Entrar com o Google" não aparece.
# Crie em https://console.cloud.google.com → APIs e serviços → Credenciais →
# "ID do cliente OAuth" (tipo: Aplicativo da Web). URI de redirecionamento:
#   http://localhost:3001/api/auth/callback/google   (dev — ajuste a porta)
#   https://SEU-DOMINIO/api/auth/callback/google     (produção)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
